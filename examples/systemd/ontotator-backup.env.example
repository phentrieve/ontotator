# /etc/ontotator/backup.env (owner the backup user, mode 0600). Example values
# only: replace every one. Never commit the real file. Read by
# examples/systemd/ontotator-backup.service; see scripts/nightly-backup.sh and
# scripts/offsite-backup.sh for every setting.

# Local recovery points (directory must exist, mode 0700).
ONTOTATOR_BACKUP_ROOT=/private/backup
ONTOTATOR_BACKUP_KEEP_DAYS=14
ONTOTATOR_BACKUP_WAIT_JOBS=600

# Off-host copy with restic (encrypted at rest). Create the repository once:
#   restic init   (with the same variables set)
ONTOTATOR_OFFSITE=restic
RESTIC_REPOSITORY=s3:https://s3.example.org/ontotator-backup
# The repository key, in a file only the backup user can read. Keep a second
# copy of the key off this host: without it the off-host copy cannot be read.
RESTIC_PASSWORD_FILE=/etc/ontotator/restic-password
# Credentials of the storage, as restic reads them for the backend. For S3:
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
# Off-host retention (restic forget) and a partial data check after each push.
ONTOTATOR_OFFSITE_KEEP_DAILY=14
ONTOTATOR_OFFSITE_KEEP_WEEKLY=8
ONTOTATOR_OFFSITE_KEEP_MONTHLY=12
ONTOTATOR_OFFSITE_CHECK_SUBSET=5%

# Restore drill of the off-host copy, on Sundays (1 = Monday ... 7 = Sunday).
# The directory is the isolated restore target of docs/operations.md (Restore).
ONTOTATOR_RESTORE_CHECK_DIR=/private/isolated-restore
ONTOTATOR_RESTORE_CHECK_DAYS=7
